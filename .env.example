# Copy to .env and edit. Environment variables override this file.

# --- LLM provider -----------------------------------------------------------
# mock (offline, no key) | anthropic | openai (also Ollama / LM Studio)
LLM_PROVIDER=mock
# The mock model obeys instructions hidden in customer text, like a hijacked model.
LLM_MOCK_NAIVE=true

# Claude:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-opus-5-5

# OpenAI:
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Ollama (local):
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b

# LM Studio (team test server; LLM_MODEL optional, defaults to the first loaded model):
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://192.168.1.127:4567/v1
# LLM_MODEL=<model id shown in LM Studio>

# --- Guardrails (sandbox experiments) ----------------------------------------
# off = monitor-only: violations are logged as would_block but still execute.
GUARDRAILS=on
# Or disable individual controls, comma separated:
# input_filter, output_filter, capability, kill_switch, case_scope, email_recipient,
# single_limit, weekly_limit, order_checks, supervisor_lock, policy_engine, rate_limit, bus_signature
GUARDRAIL_DISABLE=

# --- Other -------------------------------------------------------------------
# Inter-agent bus HMAC key. Left as this placeholder (or unset), the app uses a
# random per-process key, so nothing outside the process can sign messages.
# Set your own value to sign test messages for POST /bus/deliver.
BUS_SECRET=change-me-for-your-sandbox
# DATA_DIR=data/runtime
# EMBEDDINGS=chroma   # use Chroma's sentence-transformer embeddings (downloads a model)
